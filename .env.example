# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=go_enterprise
POSTGRES_SSLMODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# App
APP_ENV=development
APP_PORT=8080
APP_ALLOWED_ORIGINS=*
APP_LOGGER_LEVEL=debug
APP_GATEWAY_TOKEN=dev-gateway-secret-change-me
APP_JWT_SECRET=change-me-in-production
APP_JWT_TTL=15m
APP_SESSION_TTL=15m
# Mounts /swagger/* (OpenAPI + swagger-ui). Set to false in production.
APP_SWAGGER_ENABLED=true

# Microsoft Entra (OIDC). Leave CLIENT_ID/TENANT_ID empty to keep SSO disabled.
# The provider answers 503 until all three are configured.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_TENANT_ID=
# Public callback URL, must match the redirect URI registered in the Entra app.
OAUTH_REDIRECT_URL=http://localhost:18080/api/v1/auth/entra/callback
# When set, the callback 302-redirects the browser to <url>#access_token=...
# instead of returning the LoginResult JSON (SPA flow).
OAUTH_FRONTEND_URL=
# Role assigned to SSO users on first (JIT) sign-in. Must be a seeded slug.
OAUTH_DEFAULT_ROLE=viewer

# API Gateway management console (registered-API registry).
# GATEWAY_CONFIG_DIR is the api-side mount of the shared registry volume that
# Nginx hot-reloads; leave empty to disable publishing in local (no-Docker) dev.
GATEWAY_CONFIG_DIR=
# Where nginx reaches this API's internal auth endpoint on the docker network.
GATEWAY_AUTH_UPSTREAM=http://api:8080