{
  "name": "go-enterprise-api-admin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "mf:registry": "vite build -c vite.mf.registry.config.js",
    "mf:simulator": "vite build -c vite.mf.simulator.config.js",
    "mf:monitoring": "vite build -c vite.mf.monitoring.config.js",
    "mf:docs": "vite build -c vite.mf.docs.config.js",
    "build": "vite build && node scripts/build-vue.cjs && npm run mf:registry && npm run mf:simulator && npm run mf:monitoring && npm run mf:docs",
    "preview": "vite preview"
  },
  "dependencies": {
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "tailwindcss": "^4.1.0",
    "vite": "^6.0.7"
  }
}